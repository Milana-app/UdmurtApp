<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="10dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#2D2D2D"
                android:contentDescription="Назад"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Заголовок -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Соедините слово\nс его переводом"
                android:textColor="#1A1A1A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnBack" />

            <!-- Контейнер для слов -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- Левая колонка -->
                <LinearLayout
                    android:id="@+id/leftColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/rightColumn"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.4"
                    app:layout_constraintHorizontal_weight="1">

                    <!-- Слово 1 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLeft1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="2dp"
                            app:strokeColor="#D32F2F"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvLeft1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:textColor="#D32F2F"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotLeft1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_red"
                            android:translationX="6dp"
                            app:layout_constraintTop_toTopOf="@id/cardLeft1"
                            app:layout_constraintBottom_toBottomOf="@id/cardLeft1"
                            app:layout_constraintEnd_toEndOf="@id/cardLeft1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Слово 2 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLeft2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="2dp"
                            app:strokeColor="#D32F2F"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvLeft2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:textColor="#D32F2F"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotLeft2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_red"
                            android:translationX="6dp"
                            app:layout_constraintTop_toTopOf="@id/cardLeft2"
                            app:layout_constraintBottom_toBottomOf="@id/cardLeft2"
                            app:layout_constraintEnd_toEndOf="@id/cardLeft2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Слово 3 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLeft3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="2dp"
                            app:strokeColor="#D32F2F"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvLeft3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:textColor="#D32F2F"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotLeft3"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_red"
                            android:translationX="6dp"
                            app:layout_constraintTop_toTopOf="@id/cardLeft3"
                            app:layout_constraintBottom_toBottomOf="@id/cardLeft3"
                            app:layout_constraintEnd_toEndOf="@id/cardLeft3" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Слово 4 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLeft4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="2dp"
                            app:strokeColor="#D32F2F"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvLeft4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingHorizontal="8dp"
                                android:textColor="#D32F2F"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotLeft4"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_red"
                            android:translationX="6dp"
                            app:layout_constraintTop_toTopOf="@id/cardLeft4"
                            app:layout_constraintBottom_toBottomOf="@id/cardLeft4"
                            app:layout_constraintEnd_toEndOf="@id/cardLeft4" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <!-- Правая колонка -->
                <LinearLayout
                    android:id="@+id/rightColumn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@id/leftColumn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintVertical_bias="0.4"
                    app:layout_constraintHorizontal_weight="1">

                    <!-- Перевод 1 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRight1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvRight1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="#2D2D2D"
                                android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotRight1"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_grey"
                            android:translationX="-6dp"
                            app:layout_constraintTop_toTopOf="@id/cardRight1"
                            app:layout_constraintBottom_toBottomOf="@id/cardRight1"
                            app:layout_constraintStart_toStartOf="@id/cardRight1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Перевод 2 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRight2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvRight2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="#2D2D2D"
                                android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotRight2"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_grey"
                            android:translationX="-6dp"
                            app:layout_constraintTop_toTopOf="@id/cardRight2"
                            app:layout_constraintBottom_toBottomOf="@id/cardRight2"
                            app:layout_constraintStart_toStartOf="@id/cardRight2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Перевод 3 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginBottom="16dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRight3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvRight3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="#2D2D2D"
                                android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotRight3"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_grey"
                            android:translationX="-6dp"
                            app:layout_constraintTop_toTopOf="@id/cardRight3"
                            app:layout_constraintBottom_toBottomOf="@id/cardRight3"
                            app:layout_constraintStart_toStartOf="@id/cardRight3" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Перевод 4 -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardRight4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent">
                            <TextView
                                android:id="@+id/tvRight4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textColor="#2D2D2D"
                                android:textSize="16sp" />
                        </com.google.android.material.card.MaterialCardView>
                        <View
                            android:id="@+id/dotRight4"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_dot_grey"
                            android:translationX="-6dp"
                            app:layout_constraintTop_toTopOf="@id/cardRight4"
                            app:layout_constraintBottom_toBottomOf="@id/cardRight4"
                            app:layout_constraintStart_toStartOf="@id/cardRight4" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <com.example.udmurtapp.LineOverlayView
                    android:id="@+id/lineOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Кнопка и узор -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />

        <!-- Кнопка Проверить -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="Проверить"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:background="@drawable/bg_button_check" />

        <!-- Узор -->
        <LinearLayout
            android:id="@+id/llPattern"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:weightSum="10">
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
            <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/ornament_red" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>